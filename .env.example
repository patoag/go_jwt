# Configuración de la Base de Datos
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=go_jwt_db
DB_SSLMODE=disable

# Configuración de Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Configuración JWT
JWT_SECRET=mi-super-secreto-jwt-key-2024-cambiar-en-produccion
JWT_EXPIRATION_HOURS=24

# Configuración del Servidor
PORT=8080
GIN_MODE=debug

# Configuración de CORS (orígenes separados por coma)
CORS_ALLOWED_ORIGINS=*

# Configuración de Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
